<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Plantoir.Views.AssistWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" Padding="16" RowSpacing="12"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock x:Name="Heading" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <TextBlock x:Name="Subheading" Opacity="0.7"
                       Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- The prompt shelf of things a teacher can ask for -->
        <Border x:Name="PromptShelfArea" Grid.Row="1" Visibility="Collapsed"
                BorderThickness="0,0,0,1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Padding="0,0,0,8" Margin="0,0,0,4">
            <ContentControl x:Name="PromptShelfHost" HorizontalContentAlignment="Stretch" />
        </Border>

        <!-- The transcript. Every turn is a card, so a plan the teacher is
             being asked to approve is visibly a thing said, not chrome. -->
        <ScrollViewer x:Name="TranscriptScroller" Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Transcript" Spacing="10" />
        </ScrollViewer>

        <!-- The approval bar. Hidden until a write is actually waiting, so it
             never reads as a decision the teacher has already been asked for. -->
        <Border x:Name="ApprovalBar" Grid.Row="3" Visibility="Collapsed"
                Padding="12" CornerRadius="6"
                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ApprovalText" Grid.Column="0" TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <Button x:Name="DeclineButton" Grid.Column="1" Content="No"
                        Click="Decline_Click"
                        AutomationProperties.AutomationId="assistDeclineButton" />
                <Button x:Name="ApproveButton" Grid.Column="2" Content="Go ahead"
                        Style="{ThemeResource AccentButtonStyle}" Click="Approve_Click"
                        AutomationProperties.AutomationId="assistApproveButton" />
            </Grid>
        </Border>

        <Grid Grid.Row="4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Input" Grid.Column="0" PlaceholderText="Ask about this section…"
                     IsEnabled="False" KeyDown="Input_KeyDown"
                     AutomationProperties.AutomationId="assistInput" />
            <Button x:Name="SendButton" Grid.Column="1" Content="Send" IsEnabled="False"
                    Style="{ThemeResource AccentButtonStyle}" Click="Send_Click"
                    AutomationProperties.AutomationId="assistSendButton" />
        </Grid>
    </Grid>
</Window>
