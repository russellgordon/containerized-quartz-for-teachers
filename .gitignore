courses/
.verify-export.*
__pycache__/

# A generated recipe mirror the launchers create inside a working folder
# (the repo root becomes one when the launchers are run in place).
.toolchain/

# Windows app build output
windows-app/**/bin/
windows-app/**/obj/

# Repo-local Claude skills are shared content the whole team (and the
# Windows machine) needs — un-ignore them past the global rule that
# hides .claude/ everywhere. Anything else in .claude/ stays private.
!.claude/
.claude/*
!.claude/skills/

# Windows release bundles (publish.ps1 output)
windows-app/dist/
